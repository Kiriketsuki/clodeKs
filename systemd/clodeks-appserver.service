[Unit]
# Stop restarting after 5 failures in 2 minutes, for example when codex is gone.
StartLimitIntervalSec=120
StartLimitBurst=5
Description=clodeKs shared Codex app-server on a Unix socket
Documentation=https://github.com/Kiriketsuki/clodeKs

[Service]
UMask=0077
Type=simple
# install.sh writes CLODEKS_CODEX_BIN and a PATH with node here. nvm is not loaded outside a shell.
EnvironmentFile=-%h/.config/clodeks/env
ExecStart=%h/.local/bin/clodeks serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
